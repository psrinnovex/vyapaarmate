generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  SUPPORT_AGENT
  OWNER
  CUSTOMER
  MANAGER
  KITCHEN_STAFF
  DELIVERY_STAFF
}

enum SubscriptionPlan {
  STARTER
  PRO
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum BusinessKycStatus {
  PAYMENT_PENDING
  DOCUMENTS_PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum BusinessKycDocumentType {
  BUSINESS_REGISTRATION
  OWNER_ID
  ADDRESS_PROOF
  BANK_PROOF
}

enum FoodType {
  VEG
  NON_VEG
  EGG
  NOT_APPLICABLE
}

enum OrderStatus {
  NEW
  ACCEPTED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum DataOrigin {
  LIVE
  HISTORICAL_IMPORT
  MANUAL
  EXTERNAL_BENCHMARK
  DEMO
  SEED
  TEST
}

enum PilotCohort {
  BENGALURU
  ANDHRA_PRADESH
}

enum OrderType {
  PICKUP
  DELIVERY
  DINE_IN
  SERVICE_AT_LOCATION
}

enum PaymentProvider {
  RAZORPAY
  CASHFREE
  UPI
  CASH
}

enum WalletEntryType {
  ORDER_PAYMENT_CREDIT
  PAYOUT_DEBIT
  REFUND_DEBIT
  ADJUSTMENT_CREDIT
  ADJUSTMENT_DEBIT
}

enum WalletEntryStatus {
  PENDING_PROVIDER_SETTLEMENT
  AVAILABLE
  PROCESSING_PAYOUT
  SETTLED
  CANCELLED
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum BusinessPayoutStatus {
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum BusinessPayoutMethod {
  UPI
  BANK_TRANSFER
}

enum WhatsappStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  CUSTOMER_WEB
  DASHBOARD
  WHATSAPP
  AI_ASSISTED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum SupportTicketStatus {
  OPEN
  IN_REVIEW
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportTicketSource {
  CHATBOT
  ADMIN
  PAYMENT_DESK
  EMAIL
}

enum SupportTicketMessageSender {
  CUSTOMER
  BOT
  AGENT
  SYSTEM
}

enum MobilePlatform {
  IOS
  ANDROID
}

enum AccountDeletionScope {
  CUSTOMER
  STAFF
  BUSINESS
}

enum AccountDeletionStatus {
  AWAITING_VERIFICATION
  REQUESTED
  PROCESSING
  COMPLETED
  CANCELLED
  REJECTED
}

model User {
  id                       String                    @id @default(cuid())
  name                     String
  email                    String                    @unique
  phone                    String?                   @unique
  passwordHash             String
  role                     Role
  emailVerifiedAt          DateTime?
  phoneVerifiedAt          DateTime?
  businessId               String?
  business                 Business?                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  registrationVerification RegistrationVerification?
  passwordResetTokens      PasswordResetToken[]
  auditLogs                AuditLog[]
  requestedSupportTickets  SupportTicket[]           @relation("SupportRequester")
  assignedSupportTickets   SupportTicket[]           @relation("SupportAssignee")
  supportTicketMessages    SupportTicketMessage[]    @relation("SupportMessageAuthor")
  appointmentProviders     AppointmentProvider[]
  mobileAuthorizationCodes MobileAuthorizationCode[]
  mobileSessions           MobileSession[]
  accountDeletionRequests  AccountDeletionRequest[]  @relation("AccountDeletionRequester")
  sessionVersion           Int                       @default(0)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@index([businessId])
  @@index([role])
}

model RegistrationVerification {
  userId             String   @id
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailCodeHash      String
  emailCodeExpiresAt DateTime
  resendAvailableAt  DateTime
  attempts           Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([emailCodeExpiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([usedAt])
}

model MobileAuthorizationCode {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId      String    @db.VarChar(64)
  redirectUri   String    @db.VarChar(500)
  codeChallenge String    @db.VarChar(128)
  codeHash      String    @unique @db.Char(64)
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt, usedAt])
}

model MobileSession {
  id                String               @id @default(cuid())
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId          String               @db.VarChar(64)
  platform          MobilePlatform
  deviceName        String?              @db.VarChar(100)
  appVersion        String?              @db.VarChar(32)
  absoluteExpiresAt DateTime
  idleExpiresAt     DateTime
  lastUsedAt        DateTime             @default(now())
  revokedAt         DateTime?
  revocationReason  String?              @db.VarChar(64)
  refreshTokens     MobileRefreshToken[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([userId, revokedAt, idleExpiresAt])
  @@index([absoluteExpiresAt])
}

model MobileRefreshToken {
  id         String        @id @default(cuid())
  sessionId  String
  session    MobileSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  generation Int
  tokenHash  String        @unique @db.Char(64)
  expiresAt  DateTime
  usedAt     DateTime?
  revokedAt  DateTime?
  createdAt  DateTime      @default(now())

  @@unique([sessionId, generation])
  @@index([sessionId, usedAt, revokedAt])
  @@index([expiresAt])
}

model PlatformPaymentSettings {
  id               String   @id @default("platform")
  directUpiEnabled Boolean  @default(false)
  upiId            String?
  upiName          String   @default("PSHR INNOVEX PRIVATE LIMITED")
  updatedByUserId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Business {
  campaignDrafts               CampaignDraft[]
  dataOrigin                   DataOrigin         @default(LIVE)
  pilotCohort                  PilotCohort?
  pilotEnrolledAt              DateTime?
  @@index([pilotCohort, dataOrigin])
  id                          String                        @id @default(cuid())
  name                        String
  slug                        String                        @unique
  ownerName                   String
  phone                       String                        @unique
  email                       String                        @unique
  address                     String
  city                        String
  state                       String
  logoUrl                     String?
  logoImage                   BusinessImage?
  businessType                String
  businessServiceTypeId       String?
  businessServiceType         BusinessServiceType?          @relation(fields: [businessServiceTypeId], references: [id], onDelete: SetNull)
  whatsappDisplayPhone        String?
  whatsappPhoneNumberId       String?                       @unique
  whatsappWabaId              String?
  whatsappAccessTokenEnc      String?
  whatsappConnected           Boolean                       @default(false)
  whatsappLiveEnabled         Boolean                       @default(false)
  whatsappApprovedAt          DateTime?
  subscriptionPlan            SubscriptionPlan              @default(STARTER)
  subscriptionStatus          SubscriptionStatus            @default(TRIAL)
  kycStatus                   BusinessKycStatus             @default(PAYMENT_PENDING)
  kycSubmittedAt              DateTime?
  kycReviewedAt               DateTime?
  kycReviewedByUserId         String?
  kycRejectionReason          String?
  isVerified                  Boolean                       @default(false)
  isActive                    Boolean                       @default(true)
  isOpen                      Boolean                       @default(true)
  businessHours               String                        @default("Open today")
  minimumOrder                Decimal                       @default(0) @db.Decimal(10, 2)
  deliveryFee                 Decimal                       @default(0) @db.Decimal(10, 2)
  latitude                    Decimal?                      @db.Decimal(9, 6)
  longitude                   Decimal?                      @db.Decimal(9, 6)
  serviceRadiusKm             Decimal                       @default(0) @db.Decimal(7, 2)
  acceptsPickup               Boolean                       @default(true)
  acceptsDineIn               Boolean                       @default(true)
  acceptsServiceAtLocation    Boolean                       @default(false)
  allowsPayLater              Boolean                       @default(true)
  appointmentBookingEnabled   Boolean                       @default(false)
  appointmentAutoConfirm      Boolean                       @default(true)
  appointmentTimezone         String                        @default("Asia/Kolkata")
  appointmentSlotInterval     Int                           @default(15)
  appointmentLeadTimeMinutes  Int                           @default(60)
  appointmentMaxAdvanceDays   Int                           @default(60)
  appointmentCancelNoticeMins Int                           @default(120)
  paymentUpiId                String?
  paymentUpiName              String?
  payoutMethod                BusinessPayoutMethod          @default(UPI)
  payoutUpiId                 String?
  payoutUpiName               String?
  payoutAccountHolderName     String?
  payoutBankName              String?
  payoutBankAccountNumber     String?
  payoutBankIfsc              String?
  cashfreePayoutBeneficiaryId String?                       @unique
  setupCompletedAt            DateTime?
  razorpayLinkedAccountId     String?                       @unique
  razorpayRouteEnabled        Boolean                       @default(false)
  cashfreeVendorId            String?                       @unique
  cashfreeSplitEnabled        Boolean                       @default(false)
  platformFeeBps              Int                           @default(0)
  users                       User[]
  categories                  MenuCategory[]
  menuItems                   MenuItem[]
  customers                   Customer[]
  orders                      Order[]
  appointments                Appointment[]
  appointmentProviders        AppointmentProvider[]
  appointmentAvailability     AppointmentAvailabilityRule[]
  appointmentTimeOff          AppointmentTimeOff[]
  payments                    Payment[]
  walletEntries               BusinessWalletEntry[]
  payouts                     BusinessPayout[]
  coupons                     BusinessCoupon[]
  whatsappMessages            WhatsappMessage[]
  subscriptions               Subscription[]
  kycDocuments                BusinessKycDocument[]
  auditLogs                   AuditLog[]
  supportTickets              SupportTicket[]
  aiInsights                  AIInsight[]
  businessHealthSnapshots     BusinessHealthSnapshot[]
  customerIntelligenceScores  CustomerIntelligenceScore[]
  demandForecasts             DemandForecast[]
  paymentPriorities           PaymentPriority[]
  intelligenceModelArtifacts  IntelligenceModelArtifact[]
  intelligenceTrainingRuns    IntelligenceTrainingRun[]
  intelligencePredictions     IntelligencePrediction[]
  accountDeletionRequests     AccountDeletionRequest[]
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt

  @@index([city, state])
  @@index([businessServiceTypeId])
  @@index([subscriptionPlan, subscriptionStatus])
  @@index([kycStatus])
  @@index([isActive, isVerified])
  @@index([isActive, isVerified, kycStatus])
  @@index([isActive, isVerified, isOpen, name])
  @@index([whatsappDisplayPhone])
  @@index([whatsappConnected, whatsappLiveEnabled])
  @@index([setupCompletedAt])
  @@index([payoutMethod])
}

model AccountDeletionRequest {
  id                      String                @id @default(cuid())
  scope                   AccountDeletionScope
  status                  AccountDeletionStatus @default(REQUESTED)
  requesterUserId         String?
  requester               User?                 @relation("AccountDeletionRequester", fields: [requesterUserId], references: [id], onDelete: SetNull)
  businessId              String?
  business                Business?             @relation(fields: [businessId], references: [id], onDelete: SetNull)
  idempotencyKeyHash      String?               @unique @db.Char(64)
  verificationTokenHash   String?               @unique @db.Char(64)
  verificationExpiresAt   DateTime?
  verifiedAt              DateTime?
  reason                  String?               @db.VarChar(500)
  retentionNoticeVersion  String                @db.VarChar(32)
  retentionNotice         String                @db.Text
  scheduledFor            DateTime
  processingAt            DateTime?
  completedAt             DateTime?
  cancelledAt             DateTime?
  retentionReviewAt       DateTime?
  retentionLastReviewedAt DateTime?
  retentionReviewCount    Int                   @default(0)
  retentionPurgeAfter     DateTime?
  retentionPurgedAt       DateTime?
  retentionHoldUntil      DateTime?
  retentionHoldReason     String?               @db.VarChar(500)
  result                  Json?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@index([scope, status, scheduledFor])
  @@index([requesterUserId, createdAt])
  @@index([businessId, status, createdAt])
  @@index([status, retentionReviewAt, retentionPurgedAt])
  @@index([status, retentionPurgeAfter, retentionPurgedAt])
}

model BusinessImage {
  businessId String   @id
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  data       Bytes
  mimeType   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model BusinessKycDocument {
  id               String                  @id @default(cuid())
  businessId       String
  business         Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type             BusinessKycDocumentType
  fileName         String
  contentType      String
  fileSize         Int
  data             Bytes
  uploadedByUserId String?
  uploadedAt       DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@unique([businessId, type])
  @@index([businessId, uploadedAt])
  @@index([type])
}

model BusinessServiceType {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String     @unique
  description String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  businesses  Business[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([isActive, sortOrder])
}

model MenuCategory {
  id               String     @id @default(cuid())
  businessId       String
  business         Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name             String
  sortOrder        Int        @default(0)
  dataOrigin       DataOrigin @default(LIVE)
  trainingEligible Boolean    @default(true)
  items            MenuItem[]

  @@unique([businessId, name])
  @@index([businessId, sortOrder])
  @@index([businessId, dataOrigin, trainingEligible])
}

model MenuItem {
  id                 String                       @id @default(cuid())
  businessId         String
  business           Business                     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId         String
  category           MenuCategory                 @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name               String
  description        String
  price              Decimal                      @db.Decimal(10, 2)
  imageUrl           String?
  image              MenuItemImage?
  foodType           FoodType                     @default(VEG)
  isAvailable        Boolean                      @default(true)
  isBestSeller       Boolean                      @default(false)
  dataOrigin         DataOrigin                   @default(LIVE)
  trainingEligible   Boolean                      @default(true)
  appointmentEnabled Boolean                      @default(false)
  durationMinutes    Int?
  bufferMinutes      Int                          @default(0)
  orderItems         OrderItem[]
  providerServices   AppointmentProviderService[]
  demandForecasts    DemandForecast[]
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  @@index([businessId, categoryId])
  @@index([businessId, isAvailable])
  @@index([businessId, isBestSeller, updatedAt])
  @@index([businessId, dataOrigin, trainingEligible])
}

model MenuItemImage {
  menuItemId String   @id
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  data       Bytes
  mimeType   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Customer {
  id                 String                      @id @default(cuid())
  businessId         String
  business           Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name               String
  phone              String
  email              String?
  address            String?
  whatsappOptIn      Boolean                     @default(false)
  marketingOptIn     Boolean                     @default(false)
  dataOrigin         DataOrigin                  @default(LIVE)
  trainingEligible   Boolean                     @default(true)
  totalOrders        Int                         @default(0)
  totalSpent         Decimal                     @default(0) @db.Decimal(12, 2)
  lastOrderAt        DateTime?
  orders             Order[]
  appointments       Appointment[]
  messages           WhatsappMessage[]
  intelligenceScores CustomerIntelligenceScore[]
  paymentPriorities  PaymentPriority[]
  createdAt          DateTime                    @default(now())

  @@unique([businessId, phone])
  @@index([businessId, lastOrderAt])
  @@index([businessId, lastOrderAt, createdAt])
  @@index([businessId, totalOrders])
  @@index([businessId, email])
  @@index([businessId, dataOrigin, trainingEligible])
}

model Order {
  id                       String            @id @default(cuid())
  publicToken              String            @unique @default(uuid())
  invoiceNumber            String?           @unique
  invoiceIssuedAt          DateTime?
  invoiceEmailSentAt       DateTime?
  refundInvoiceEmailSentAt DateTime?
  businessId               String
  business                 Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId               String
  customer                 Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orderNumber              String
  mobileRequestKeyHash     String?           @unique @db.Char(64)
  mobileRequestBodyHash    String?           @db.Char(64)
  status                   OrderStatus       @default(NEW)
  paymentStatus            PaymentStatus     @default(PENDING)
  subtotal                 Decimal           @db.Decimal(10, 2)
  deliveryFee              Decimal           @default(0) @db.Decimal(10, 2)
  discountAmount           Decimal           @default(0) @db.Decimal(10, 2)
  taxableAmount            Decimal           @default(0) @db.Decimal(10, 2)
  gstRateBps               Int               @default(1800)
  gstAmount                Decimal           @default(0) @db.Decimal(10, 2)
  couponCode               String?
  couponId                 String?
  coupon                   BusinessCoupon?   @relation(fields: [couponId], references: [id], onDelete: SetNull)
  totalAmount              Decimal           @db.Decimal(10, 2)
  orderType                OrderType
  deliveryAddress          String?
  customerLatitude         Decimal?          @db.Decimal(9, 6)
  customerLongitude        Decimal?          @db.Decimal(9, 6)
  distanceKm               Decimal?          @db.Decimal(7, 2)
  notes                    String?
  scheduledFor             DateTime?
  completedAt              DateTime?
  cancelledAt              DateTime?
  cancellationReason       String?
  noShowAt                 DateTime?
  dataOrigin               DataOrigin        @default(LIVE)
  trainingEligible         Boolean           @default(true)
  items                    OrderItem[]
  appointment              Appointment?
  payment                  Payment?
  paymentPriorities        PaymentPriority[]
  whatsappMessages         WhatsappMessage[]
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  @@unique([businessId, orderNumber])
  @@index([businessId, status, paymentStatus])
  @@index([businessId, createdAt])
  @@index([businessId, scheduledFor])
  @@index([businessId, status, scheduledFor])
  @@index([businessId, dataOrigin, trainingEligible])
  @@index([customerId])
  @@index([couponId])
  @@index([invoiceEmailSentAt])
  @@index([refundInvoiceEmailSentAt])
}

model OrderItem {
  id         String    @id @default(cuid())
  orderId    String
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  itemName   String
  quantity   Int
  price      Decimal   @db.Decimal(10, 2)
  total      Decimal   @db.Decimal(10, 2)

  @@index([orderId])
  @@index([menuItemId])
}

model AppointmentProvider {
  id                        String                        @id @default(cuid())
  businessId                String
  business                  Business                      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId                    String?
  user                      User?                         @relation(fields: [userId], references: [id], onDelete: SetNull)
  name                      String
  title                     String
  bio                       String?                       @db.Text
  color                     String                        @default("#0F766E")
  isActive                  Boolean                       @default(true)
  acceptsAtBusiness         Boolean                       @default(true)
  acceptsAtCustomerLocation Boolean                       @default(false)
  sortOrder                 Int                           @default(0)
  services                  AppointmentProviderService[]
  availabilityRules         AppointmentAvailabilityRule[]
  timeOff                   AppointmentTimeOff[]
  appointments              Appointment[]
  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime                      @updatedAt

  @@unique([businessId, userId])
  @@index([businessId, isActive, sortOrder])
}

model AppointmentProviderService {
  providerId              String
  provider                AppointmentProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  menuItemId              String
  menuItem                MenuItem            @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  durationOverrideMinutes Int?
  bufferOverrideMinutes   Int?
  createdAt               DateTime            @default(now())

  @@id([providerId, menuItemId])
  @@index([menuItemId, providerId])
}

model AppointmentAvailabilityRule {
  id          String              @id @default(cuid())
  businessId  String
  business    Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  providerId  String
  provider    AppointmentProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  weekday     Int
  startMinute Int
  endMinute   Int
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([providerId, weekday, startMinute, endMinute], map: "AppointmentAvailabilityRule_providerId_weekday_startMinute_endM")
  @@index([businessId, weekday, isActive])
  @@index([providerId, weekday, isActive])
}

model AppointmentTimeOff {
  id         String               @id @default(cuid())
  businessId String
  business   Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  providerId String?
  provider   AppointmentProvider? @relation(fields: [providerId], references: [id], onDelete: Cascade)
  startsAt   DateTime             @db.Timestamptz(3)
  endsAt     DateTime             @db.Timestamptz(3)
  reason     String?
  createdAt  DateTime             @default(now())

  @@index([businessId, startsAt, endsAt])
  @@index([providerId, startsAt, endsAt])
}

model Appointment {
  id                 String              @id @default(cuid())
  businessId         String
  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderId            String              @unique
  order              Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId         String
  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  providerId         String
  provider           AppointmentProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  startsAt           DateTime            @db.Timestamptz(3)
  endsAt             DateTime            @db.Timestamptz(3)
  blockedUntil       DateTime            @db.Timestamptz(3)
  timezone           String              @default("Asia/Kolkata")
  status             AppointmentStatus   @default(REQUESTED)
  source             AppointmentSource   @default(CUSTOMER_WEB)
  autoConfirmed      Boolean             @default(false)
  smartScore         Int?
  smartReason        String?
  confirmedAt        DateTime?           @db.Timestamptz(3)
  cancelledAt        DateTime?           @db.Timestamptz(3)
  completedAt        DateTime?           @db.Timestamptz(3)
  reminderSentAt     DateTime?           @db.Timestamptz(3)
  cancellationReason String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([businessId, startsAt, status])
  @@index([providerId, startsAt, status])
  @@index([customerId, startsAt])
  @@index([status, reminderSentAt, startsAt])
}

model Payment {
  id                          String               @id @default(cuid())
  businessId                  String
  business                    Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderId                     String               @unique
  order                       Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider                    PaymentProvider
  razorpayPaymentLinkId       String?
  razorpayPaymentId           String?              @unique
  razorpayTransferId          String?              @unique
  razorpayTransferStatus      String?
  razorpayTransferAmount      Decimal?             @db.Decimal(10, 2)
  razorpayPlatformFee         Decimal?             @db.Decimal(10, 2)
  razorpayTransferError       String?
  razorpayTransferUpdatedAt   DateTime?
  cashfreeOrderId             String?              @unique
  cashfreeCfOrderId           String?              @unique
  cashfreePaymentSessionId    String?
  cashfreePaymentId           String?              @unique
  cashfreeOrderStatus         String?
  manualVerificationReference String?              @unique
  manualVerifiedByUserId      String?
  manualVerifiedAt            DateTime?
  paymentRequestUrl           String?
  paymentRequestExpiresAt     DateTime?
  paymentReminderSentAt       DateTime?
  amount                      Decimal              @db.Decimal(10, 2)
