# Copy this file to .env.local for a local production-like check. Never commit real credentials.
# Values marked OWNER or COUNSEL require an authorized business decision; leave them blank until confirmed.

NEXT_PUBLIC_APP_URL=https://www.vyapaarmate.com
MOBILE_TOKEN_ISSUER=https://www.vyapaarmate.com
TRUSTED_ORIGINS=https://www.vyapaarmate.com

# Generate four distinct, high-entropy server-only values.
JWT_SECRET=
MOBILE_JWT_SECRET=
MOBILE_TOKEN_PEPPER=
ACCOUNT_DELETION_TOKEN_PEPPER=
ENCRYPTION_KEY=
CRON_SECRET=

# COUNSEL: must exactly match the approved account-retention notice in source.
ACCOUNT_RETENTION_POLICY_APPROVED_VERSION=

# Supabase PostgreSQL: transaction pooler for runtime; session pooler/direct host for migrations.
DATABASE_URL=
DIRECT_URL=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
GOOGLE_PLACES_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# OWNER: the documented launch market, promotion state, and applicable tax rate.
NEXT_PUBLIC_LAUNCH_MARKET=pilot-cohorts
NEXT_PUBLIC_BENGALURU_LAUNCH_OFFER=
SUBSCRIPTION_GST_RATE_BPS=

EMAIL_FROM=
RESEND_API_KEY=
SMS_VERIFICATION_ENABLED=false

# OWNER: legal payment receiver and approved live Cashfree credentials.
PAYMENT_RECEIVER_NAME=
PAYMENT_PROVIDER_SETTLEMENT_DAYS=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=production
CASHFREE_CURRENCY=INR
CASHFREE_SPLIT_ENABLED=false

# Optional integrations. Enable only after their provider and privacy review is complete.
WHATSAPP_LIVE_SENDS_ENABLED=false
CHATBOT_STORE_RAW_MESSAGES=false
RATE_LIMIT_FAIL_OPEN=false
